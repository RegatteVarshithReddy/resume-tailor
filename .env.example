# Copy to .env (git-ignored) and fill in what you use, or set these on the
# Settings tab in the web app. An env var here always overrides settings.yaml.

# --- AI provider API keys (only the one you pick is needed) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Any other provider: RESUME_TAILOR_<NAME>_KEY, e.g. RESUME_TAILOR_GROQ_KEY=

# --- optional overrides ---
# Force a provider / model regardless of settings.yaml:
# RESUME_TAILOR_ENGINE=openai
# RESUME_TAILOR_MODEL=gpt-4o
# Where profile/, data/, outputs/ live (default: current directory):
# RESUME_TAILOR_HOME=/path/to/resume-tailor-data
